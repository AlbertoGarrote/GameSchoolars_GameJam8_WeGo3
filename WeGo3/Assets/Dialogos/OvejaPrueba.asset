  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: OvejaPrueba
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: Oveja
    texto: Soy una puta oveja
    retrato: {fileID: -8504504408042065948, guid: 9a06d64ea0273444e9aaa0506c4f5dcb, type: 3}
    sonidoTipeo: {fileID: 8300000, guid: 5b1783e1b0caab448b92fc8ae00fac5b, type: 3}
  - nombrePersonaje: Oveja
    texto: "Bastante \xE9pico"
    retrato: {fileID: -8504504408042065948, guid: 9a06d64ea0273444e9aaa0506c4f5dcb, type: 3}
    sonidoTipeo: {fileID: 8300000, guid: 5b1783e1b0caab448b92fc8ae00fac5b, type: 3}
  - nombrePersonaje: Oveja
    texto: A que si?
    retrato: {fileID: -8504504408042065948, guid: 9a06d64ea0273444e9aaa0506c4f5dcb, type: 3}
    sonidoTipeo: {fileID: 8300000, guid: 5b1783e1b0caab448b92fc8ae00fac5b, type: 3}
  - nombrePersonaje: Oveja
    texto: "No te lo vas a creer. Ayer me di cuenta de que pod\xEDa hablar. \xA1qu\xE9
      barbaridad!"
    retrato: {fileID: -8504504408042065948, guid: 9a06d64ea0273444e9aaa0506c4f5dcb, type: 3}
    sonidoTipeo: {fileID: 8300000, guid: 5b1783e1b0caab448b92fc8ae00fac5b, type: 3}
