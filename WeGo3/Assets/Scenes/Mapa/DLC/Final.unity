--- !u!114 &1882109627
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1882109625}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Juego hecho por:\r\n\r\nWEGOTEAM\r\n\r\n\r\nProgramaci\xF3n y Arte de
    fondos - Garrote\r\n\r\nArte de personajes - Ismael\r\n\r\nGame Design - El Isma
    sobretodo pero los dosh\r\n\r\nSonido y m\xFAsica - La vieja confiable de Pixabay
    porque no tenemos ni idea ninguno de los dos de componer.\r\n\r\nAcordarse de
    bromas internas para los di\xE1logos - Ismael\r\n\r\nFactor c\xF3mico - El Ismael
    sobretodo\r\n\r\nAguantar a Isma - Garrote\r\n\r\nDibujar a los Neosinos para
    el DLC - Isma\r\n\r\nProgramaci\xF3n de todo lo nuevo - Garrote otra vez\r\n\r\nEnfadarse
    mogoll\xF3n - Garrote pa variar\r\n\r\nVacilar de m\xE1s - Isma\r\n\r\nCalentarse
    pa hacer el DLC - Los dos\r\n\r\nGuardar el secreto para que no nos pille nadie
    - Los dos pero por los pelos\r\n\r\nEl chiste de Bob Dylan - Isma\r\n\r\nMolar
    mucho - Los dos\r\n\r\nSer guapos - Los dos\r\n\r\nTener mucho amor propio -
    Los dos\r\n\r\nAcercarle cosas del estante de arriba a Garrote - Isma\r\n\r\nP\xE9rdida
    capilar - Isma\r\n\n\n\r\nESPECIAL AGRADECIMIENTOS y gente apoyando:\r\n\r\nA
    todo Neosino\r\n\r\nA los Pill Poppers\r\n\r\nA los vascos\r\n\r\nAl Subway Surfers\r\n\r\nAl
    Intervoley\r\n\r\nAl Tiffanys\r\n\r\nA Tu Francis de la Bachata\r\n\r\nA Bob
    Dylan\r\n\r\nA Hatsune Miku\r\n\r\nDedicado a nuestros amigos, otra vez. Por
    hacer que currar en este juego (dos veces, una en secreto) merezca la pena.\r\n\r\nOs
    queremos mucho.\r\n\r\n\n\n\n\n\r\n\xA1GRACIAS POR JUGAR!\r\n\r\n\r\n<3"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bbe6085374b5374e8b7cc04617bf084, type: 2}
