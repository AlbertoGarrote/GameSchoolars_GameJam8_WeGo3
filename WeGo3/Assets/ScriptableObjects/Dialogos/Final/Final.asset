%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: Final
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: 
    texto: Pues bueno... Por fin consigues llegar hasta mi.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: "Se\xF1or Meon"
    texto: "\xBFC\xF3mo te has sentido?"
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: "Pues bueno... Podr\xEDas haberme esperado fuera de casa, \xBFsabes?"
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "Tu madre y yo hablamos, nos preocupabas. Asi que se nos ocurri\xF3 un
      plan para hacerte salir de casa. "
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: Pues tampoco creo que haya funcionado... He seguido dando la nota... Como
      siempre...
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: Ayudaste a mucha gente, a los patos, al granjero, a la sepulturera...
      Incluso lo diste todo en las fiestas.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: "Yo creo que ha merecido la pena \"dar tanto la nota\" como dices t\xFA."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: "Vi\xE9ndolo as\xED... Puedo llegar a creerte."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "Pues claro que s\xED. Pero bueno, disfrutemos el artardecer antes de
      irnos."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: "Mmmm s\xED, claro. Antes de irnos."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  opciones: []
