  m_Name: tutorio 5
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: Tutorio
    texto: "\xA1Hombre, machote! La ciudad rebosa alegr\xEDa, \xA1has ayudado a todo
      el mundo! Te mereces descansar un poco, ve a las fiestas de Wegotown. "
    retrato: {fileID: 1067047807355941414, guid: a52e42c2be49fe340b5b9ea713e74add, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Tutorio
    texto: "Est\xE1n celebr\xE1ndose al noreste de la ciudad. Seguro que all\xED
      encuentras lo que llevas tanto tiempo buscando."
    retrato: {fileID: 1067047807355941414, guid: a52e42c2be49fe340b5b9ea713e74add, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  opciones: []
