    sonidoVoz: {fileID: 8300000, guid: 02b3ddabf8e9af24689b213918052125, type: 3}
  - nombrePersonaje: Amarillo
    texto: "\xA1Soy s\xFAper fan, te escucho desde el concierto de WegoCampamento!"
