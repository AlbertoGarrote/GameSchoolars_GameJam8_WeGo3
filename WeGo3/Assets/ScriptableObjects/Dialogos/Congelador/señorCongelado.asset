  - nombrePersonaje: 
    texto: "(Se le nota que est\xE1 desvariando y tiene cierto acento ingl\xE9s.)"
    retrato: {fileID: 6593822253507500307, guid: e2efca1492facd84e8acfae49a724baa, type: 3}
