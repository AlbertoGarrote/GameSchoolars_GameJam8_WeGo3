  m_Name: "se\xF1orCongelado"
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: hombre congelado
    texto: "Hola buneas, \xBFla casa tiene radiadores para calentarse? Que no puedo
