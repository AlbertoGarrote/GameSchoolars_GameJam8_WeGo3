  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: "17a\xF1osDure"
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: 
    texto: "Co\xF1o el m\xEDo la mujel m\xEDa, dur\xE9 diecisiete a\xF1os con ella...
      me fue infiel, loco."
    retrato: {fileID: 5352340678560164223, guid: 3ccf5039ddc11cf40a0cb3583649749f, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: "\xBFY saben con qui\xE9n me fue infiel?"
    retrato: {fileID: 5352340678560164223, guid: 3ccf5039ddc11cf40a0cb3583649749f, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: "Con mi pap\xE1."
    retrato: {fileID: 5352340678560164223, guid: 3ccf5039ddc11cf40a0cb3583649749f, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: Wegojimson
    texto: "Ay, el m\xEDo"
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  opciones: []
