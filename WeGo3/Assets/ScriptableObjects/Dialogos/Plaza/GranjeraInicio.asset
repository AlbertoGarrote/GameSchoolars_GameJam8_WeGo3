MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: GranjeraInicio
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: Wegojimson
    texto: "Buenas, \xBFha visto usted a un se\xF1or de espalda ancha y pelo negro
      por aqu\xED?"
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: Granjera
    texto: "Ay, mijo. Qu\xE9 chico tan educado. Ahora mismo no me suena... "
    retrato: {fileID: 4030727517424287167, guid: a6c474b252d721644a25ac2619e32f6d, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Granjera
    texto: "Oye chiquillo, pareces fuerte. Ay\xFAdame con un problemilla que tengo
      aqu\xED en mi plantaci\xF3n de \xF1ames."
    retrato: {fileID: 4030727517424287167, guid: a6c474b252d721644a25ac2619e32f6d, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Granjera
    texto: "Han aparecido unos muy raros de color rosa y no s\xE9 c\xF3mo hacer que
      paren de reproducirse... Ay\xFAdame."
    retrato: {fileID: 4030727517424287167, guid: a6c474b252d721644a25ac2619e32f6d, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Wegojimson
    texto: "\xA1Esto es un claro caso de plaga de \xF1emas rosas! Ver\xE9 qu\xE9
      puedo hacer...\n"
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  opciones: []
