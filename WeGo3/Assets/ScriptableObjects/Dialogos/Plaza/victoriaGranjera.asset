  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: victoriaGranjera
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: Wegojimson
    texto: "No va a tener que preocuparse m\xE1s por esa plaga de \xF1emas rosas."
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: Granjera
    texto: 'Ay, mijo. Muchas gracias.  '
    retrato: {fileID: 4030727517424287167, guid: a6c474b252d721644a25ac2619e32f6d, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Granjera
    texto: "Sobre tu amigo... Dicen que ha aparecido un chaval raro en la pista de
      baloncesto, al oeste de aqu\xED. A lo mejor es a quien buscas."
    retrato: {fileID: 4030727517424287167, guid: a6c474b252d721644a25ac2619e32f6d, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Wegojimson
    texto: "Gracias por la informaci\xF3n. \xA1Nos vemos!"
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  opciones: []
