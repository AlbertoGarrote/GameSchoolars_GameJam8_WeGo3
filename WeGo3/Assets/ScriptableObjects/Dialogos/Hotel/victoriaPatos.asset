  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: victoriaPatos
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: "Pato N\xBA70"
    texto: "\xA1Incre\xEDble!"
    retrato: {fileID: 4599121207734329647, guid: c2362f3062fe2a84f98edbaac1e72a39, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: "Pato N\xBA31"
    texto: "\xA1Muchas gracias! No sabemos que habr\xEDa sido de nosotros sin tu
      ayuda."
    retrato: {fileID: 4599121207734329647, guid: c2362f3062fe2a84f98edbaac1e72a39, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Wegojimson
    texto: Elemental, querido Cuackson.
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: "Pato N\xBA66"
    texto: "As\xED podremos ir a las fiestas de WeGoTown, que empiezan en nada."
    retrato: {fileID: 4599121207734329647, guid: c2362f3062fe2a84f98edbaac1e72a39, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: "Pato N\xBA19"
    texto: "Te veremos por all\xED, \xBFno? Dicen que va a estar todo el mundo."
    retrato: {fileID: 4599121207734329647, guid: c2362f3062fe2a84f98edbaac1e72a39, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: "Pato N\xBA92"
    texto: 'Son al noreste de la ciudad. Esperamos que no te las pierdas. Toca un
      grupo de renombre: Garden Kolony.'
    retrato: {fileID: 4599121207734329647, guid: c2362f3062fe2a84f98edbaac1e72a39, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Wegojimson
    texto: "Con que va todo el mundo... Espero poder encontrarle por all\xED..."
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  opciones: []
