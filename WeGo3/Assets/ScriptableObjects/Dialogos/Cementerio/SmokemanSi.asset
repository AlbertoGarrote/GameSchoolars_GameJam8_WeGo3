  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: SmokemanSi
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: SmokeMan
    texto: "Haces bien, todos tenemos una forma de liberar nuestra ansiedad, aunque
      lo mio ya es adicci\xF3n."
    retrato: {fileID: -524229732588599491, guid: aa27168ce66627d44ad57499eed6aba6, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: SmokeMan
    texto: "A mi ya no me sube nada, estoy m\xE1s que acostumbrado."
    retrato: {fileID: -524229732588599491, guid: aa27168ce66627d44ad57499eed6aba6, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: SmokeMan
    texto: "Los camellos de la zona me han puesto el apodo de Smokeman, as\xED que
      imag\xEDnate."
    retrato: {fileID: -524229732588599491, guid: aa27168ce66627d44ad57499eed6aba6, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  opciones: []
