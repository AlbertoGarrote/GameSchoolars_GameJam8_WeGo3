  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: ramoncinSpiderman
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: "Ramonc\xEDn"
    texto: "\xA1Hostia, Spiderman! \xBFPuedo hacerte unas preguntas para SomosTontos:
      El Podcast?"
    retrato: {fileID: 8227722336521858258, guid: 8a2d8f826fe9e5544800c810a54d4f41, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 02b3ddabf8e9af24689b213918052125, type: 3}
  - nombrePersonaje: Spiderman
    texto: "\xA1Claro que s\xED, primo! Todo por el barrio."
    retrato: {fileID: 5534343231670134436, guid: 23aa4d7929480694da3b0792bcac0a5c, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: "Ramonc\xEDn"
    texto: "\xBFEres m\xE1s amigo, o m\xE1s vecino?"
    retrato: {fileID: 8227722336521858258, guid: 8a2d8f826fe9e5544800c810a54d4f41, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 02b3ddabf8e9af24689b213918052125, type: 3}
  - nombrePersonaje: Spiderman
    texto: Un poquito de las dos.
    retrato: {fileID: 5534343231670134436, guid: 23aa4d7929480694da3b0792bcac0a5c, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: "Ramonc\xEDn"
    texto: "Hasta aqu\xED la entrevista. \xA1Muchas gracias, Spiderman! Eres un grande.
      M\xE1s concretamente como dos palmos y dos dedos de grande."
    retrato: {fileID: 8227722336521858258, guid: 8a2d8f826fe9e5544800c810a54d4f41, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 02b3ddabf8e9af24689b213918052125, type: 3}
  - nombrePersonaje: Wegojimson
    texto: Eso es enorme.
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  opciones: []
