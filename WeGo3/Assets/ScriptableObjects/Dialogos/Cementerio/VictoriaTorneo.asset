  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: VictoriaTorneo
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: Edoardo
    texto: "\xBFPor qu\xE9 no me hab\xEDas dicho que eras un experto? "
    retrato: {fileID: -2443908968582167363, guid: 25da3e0155041484d885336c90764544, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: Edoardo
    texto: "Esa forma que le has dado al cigarro... si tuviera que darle una nota
      ser\xEDa un diez. "
    retrato: {fileID: -2443908968582167363, guid: 25da3e0155041484d885336c90764544, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: Edoardo
    texto: "Ahora que me has ganado, nos iremos a otro lado. Me han dicho que la
      zona del hotel est\xE1 bastante bien."
    retrato: {fileID: -2443908968582167363, guid: 25da3e0155041484d885336c90764544, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  opciones: []
