%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: SepultureraAntes
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: Wegojimson
    texto: "Hola, buenas. Greg me dijo que sabr\xEDas decirme d\xF3nde se encuentra
      mi amigo."
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: Sepulturera
    texto: "Bienvenido Wegojimson, hijo de Wegojim. Lamento decirte que no s\xE9
      d\xF3nde est\xE1 tu amigo, pero el destino te ha enviado aqu\xED a ayudarme."
    retrato: {fileID: 2495945715043059050, guid: 772e6b4ae53afb542b2c4d74caee9279, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Wegojimson
    texto: "Se\xF1ora, su\xE9lteme el brazo. Luego soy yo el que da la nota."
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: Sepulturera
    texto: "Perdona, es que a veces me come el personaje. \xBFMe puedes echar un
      cable? Estoy harta del torneo que se celebra detr\xE1s de mi cementerio. "
    retrato: {fileID: 2495945715043059050, guid: 772e6b4ae53afb542b2c4d74caee9279, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Sepulturera
    texto: "\xBFPuedes ir y pedirles que se vayan?"
    retrato: {fileID: 2495945715043059050, guid: 772e6b4ae53afb542b2c4d74caee9279, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 9cade6e64582c344694f51611d488223, type: 3}
  - nombrePersonaje: Wegojimson
    texto: "Bueno... Ver\xE9 qu\xE9 puedo hacer. A lo mejor \xE9l est\xE1 por all\xED
      tambi\xE9n."
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  opciones: []
