%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: FinalDLC
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: 
    texto: "\xBFQu\xE9 hac\xE9is los dos aqu\xED?"
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "\xBFQu\xE9 tal, Wego? Te noto algo diferente."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: 'Tu amigo me ha contado todo lo que has hecho por los vecinos de WeGoTown. '
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: Estoy muy orgullosa de ti.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "Es posible que dar tanto la nota no est\xE9 tan mal, siempre y cuando
      sea como lo haces t\xFA."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: "\xBFT\xFA crees?"
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: En la vida, cada uno elige su propio camino.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "Me gusta mucho el que has elegido t\xFA."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: Muchas gracias... a los dos.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: Ahora disfrutemos de este amanecer todos juntos.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: Claro, juntos.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  opciones: []
