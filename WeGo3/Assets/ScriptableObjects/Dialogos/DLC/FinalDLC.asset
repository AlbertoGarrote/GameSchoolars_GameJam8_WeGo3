%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: FinalDLC
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: 
    texto: "\xBFQu\xE9 hac\xE9is los dos aqu\xED?"
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "Hombre, bello durmiente, \xBFqu\xE9 tal has descansado?"
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: Hola, hijo. Le he avisado yo.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "\xBFT\xFA sab\xEDas d\xF3nde estaba todo este tiempo?"
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "Tu amigo y yo planeamos todo esto. Nos preocupabas, as\xED que le dije
      que hiciera el plan de ir a la fiesta contigo para que te despejaras."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "No s\xE9 si ha funcionado mucho, sigo pensando en lo que te dije ayer..."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "No es un cambio que se hace de la noche a la ma\xF1ana, Wego. Pero centr\xE1te
      en lo que te expliqu\xE9: "
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "Intenta vivir tu vida. Rod\xE9ate de gente que te haga el mismo bien
      que t\xFA le haces a ellos."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "Y disfruta de las peque\xF1as cosas que te brinda la vida, como este
      amanecer tan bonito."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "...creo que tienes raz\xF3n, mam\xE1... Muchas gracias a los dos, de
      verdad."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "No hay de qu\xE9, ya sabes que si quieres hacer cualquier plan, aqu\xED
      me tienes."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 0f450ea706440784b892277334fab526, type: 3}
  - nombrePersonaje: 
    texto: Me apunto a lo que sea.
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "De momento, chicos, disfrutemos de este amanecer un poco m\xE1s."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "S\xED... Hag\xE1moslo..."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  opciones: []
