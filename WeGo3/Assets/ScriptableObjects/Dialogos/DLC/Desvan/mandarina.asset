  - nombrePersonaje: 
    texto: "Entr\xF3 por la ventana de un segundo piso a toda velocidad. Casi lo
      perdemos."
    retrato: {fileID: 6593822253507500307, guid: e2efca1492facd84e8acfae49a724baa, type: 3}
