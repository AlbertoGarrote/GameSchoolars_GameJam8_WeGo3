    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: Ipad Kid
    texto: "\xA1Wego! \xBFHas jugado al surfeadores del Subway? \xA1Sales t\xFA!"
