%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: madreMinijuego
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: 
    texto: "Pues no s\xE9 por d\xF3nde empezar, la verdad..."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "\xBFHas vuelto a recaer? \xBFTengo que llamar otra vez a la Conchi?"
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "No es eso, mam\xE1. He estado pensando en todo desde que me llamaste
      el otro d\xEDa. "
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "Sinceramente, me doli\xF3 c\xF3mo me dijiste las cosas. Porque en el
      fondo tienes raz\xF3n."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: ...
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "Y a veces no s\xE9 c\xF3mo hacer las cosas bien..."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "Hijo... Puede ser que perdiera los nervios el otro d\xEDa. Desde que
      tu padre no est\xE1, est\xE1 siendo todo muy complicado."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "Pero eso no justifica c\xF3mo he hecho las cosas y c\xF3mo te he tratado.
      Lo siento, de verdad."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: 
    texto: "Gracias, mam\xE1. Significa mucho para m\xED."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "Me esforzar\xE9 para que los dos sigamos adelante."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: 
    texto: "Yo tambi\xE9n, hag\xE1moslo juntos."
    retrato: {fileID: 0}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  opciones: []
