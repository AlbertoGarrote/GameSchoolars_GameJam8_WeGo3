  m_Script: {fileID: 11500000, guid: a6b08e0677fcb01489e01d1098416517, type: 3}
  m_Name: madreAntes
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSO
  lineas:
  - nombrePersonaje: WegoMadre
    texto: "\xA1Anda, hijo! "
    retrato: {fileID: -1624767115544335515, guid: 1123a95359cd70043a33a2b025913e6a, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: WegoMadre
    texto: 'No te voy a reconocer a este paso... '
    retrato: {fileID: -1624767115544335515, guid: 1123a95359cd70043a33a2b025913e6a, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: Wegojimson
    texto: "No digas eso, mam\xE1..."
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: WegoMadre
    texto: "Es una broma, hijo. \xBFAl final te has decidido a visitarme? No era
      tan complicado, eh. \xBFSacaste la basura como te dije?"
    retrato: {fileID: -1624767115544335515, guid: 1123a95359cd70043a33a2b025913e6a, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  - nombrePersonaje: Wegojimson
    texto: "S\xED.\nY bueno, hay una cosa que tengo que decirte..."
    retrato: {fileID: 1990822097062845535, guid: 7cb46cc978a731149bdbd6eb0d21a080, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 4d44b46eedbfadc48bdcd96c28bfb0d3, type: 3}
  - nombrePersonaje: WegoMadre
    texto: "Claro que s\xED, cari\xF1o. Cu\xE9ntame."
    retrato: {fileID: -1624767115544335515, guid: 1123a95359cd70043a33a2b025913e6a, type: 3}
    sonidoVoz: {fileID: 8300000, guid: 63ac06d826ef2904c98a43a3891ddb3e, type: 3}
  opciones: []
